{
  "resources": {
    "settings": {
      "name": "settings",
      "fields": [
        { "key": "max_run_usd", "scope": "project", "group": "cost", "type": "float", "scopes": ["config:write"], "help": "Per-run cost-cap base in USD.", "default": 1.0 },
        { "key": "models.agent", "scope": "project", "group": "model", "type": "object", "scopes": ["config:write"], "help": "Agent loop model selection.", "default": { "tier": "standard" }, "members": [
          { "key": "tier", "type": "enum", "enum": ["standard", "pro", "max"], "help": "Ladder rung." },
          { "key": "model", "type": "model", "help": "Pinned model override." },
          { "key": "effort", "type": "enum", "enum": ["minimal", "low", "medium", "high", "xhigh"], "help": "Reasoning effort." }
        ] },
        { "key": "models.image", "scope": "project", "group": "model", "type": "object", "scopes": ["config:write"], "help": "Image-describe model selection.", "default": { "model": "vendor/img" }, "members": [
          { "key": "model", "type": "model", "help": "Pinned model override." }
        ] }
      ]
    },
    "kb": {
      "name": "kb",
      "fields": [
        { "key": "provider", "scope": "project", "group": "kb", "type": "enum", "enum": ["intercom", "supporthero", "knowledgeowl"], "scopes": ["config:write"], "help": "KB provider." },
        { "key": "base_url", "scope": "project", "group": "kb", "type": "url", "scopes": ["config:write"], "help": "KB API base URL." }
      ]
    },
    "action": {
      "name": "action",
      "fields": [
        { "key": "actions_enabled", "scope": "project", "group": "action", "type": "bool", "scopes": ["admin:box"], "help": "Whether the action plane is enabled." },
        { "key": "action_reverse_secret", "scope": "project", "group": "action", "type": "secret", "scopes": ["admin:box"], "sensitive": true, "help": "Reverse-channel HMAC secret (write-only)." }
      ]
    }
  },
  "hierarchy_settings": {
    "channel": {
      "settable_at": ["project", "tenant", "mailbox"],
      "fields": ["labeling_enabled", "inbox_cleaning_enabled", "draft_font_css", "note_from_address", "follow_up_enabled", "follow_up_max_steps", "follow_up_max_horizon_days", "chat_mode"],
      "field_schemas": [
        { "key": "channel.labeling_enabled", "scope": "project", "group": "channel", "type": "bool", "scopes": ["config:write"], "settable_at": ["project", "tenant", "mailbox"], "help": "Apply triage labels to incoming mail." },
        { "key": "channel.inbox_cleaning_enabled", "scope": "project", "group": "channel", "type": "bool", "scopes": ["config:write"], "settable_at": ["project", "tenant", "mailbox"], "help": "Clean quoted history from the assembled thread." },
        { "key": "channel.draft_font_css", "scope": "project", "group": "channel", "type": "string", "scopes": ["config:write"], "settable_at": ["project", "tenant", "mailbox"], "help": "CSS font declaration applied to placed drafts." },
        { "key": "channel.note_from_address", "scope": "project", "group": "channel", "type": "string", "scopes": ["config:write"], "settable_at": ["project", "tenant", "mailbox"], "help": "From address used on processor notes." },
        { "key": "channel.follow_up_enabled", "scope": "project", "group": "channel", "type": "bool", "scopes": ["config:write"], "settable_at": ["project", "tenant", "mailbox"], "help": "Place a follow-up draft when a question goes unanswered." },
        { "key": "channel.follow_up_max_steps", "scope": "project", "group": "channel", "type": "int", "scopes": ["config:write"], "settable_at": ["project", "tenant", "mailbox"], "help": "Most follow-up nudges on one thread." },
        { "key": "channel.follow_up_max_horizon_days", "scope": "project", "group": "channel", "type": "int", "scopes": ["config:write"], "settable_at": ["project", "tenant", "mailbox"], "help": "Latest a follow-up may fire, in days." },
        { "key": "channel.chat_mode", "scope": "project", "group": "channel", "type": "enum", "enum": ["consumer", "power"], "scopes": ["config:write"], "settable_at": ["project", "tenant"], "help": "How deep chat turns go." }
      ]
    },
    "persona": {
      "settable_at": ["project", "tenant", "mailbox"],
      "fields": ["signature", "tone", "language", "formality", "guidance"],
      "field_schemas": [
        { "key": "persona.signature", "scope": "project", "group": "persona", "type": "text", "scopes": ["config:write"], "settable_at": ["project", "tenant", "mailbox"], "help": "Sign-off the reply uses." },
        { "key": "persona.tone", "scope": "project", "group": "persona", "type": "text", "scopes": ["config:write"], "settable_at": ["project", "tenant", "mailbox"], "help": "Voice for replies." },
        { "key": "persona.language", "scope": "project", "group": "persona", "type": "text", "scopes": ["config:write"], "settable_at": ["project", "tenant", "mailbox"], "help": "Main language for customer-facing output." },
        { "key": "persona.formality", "scope": "project", "group": "persona", "type": "text", "scopes": ["config:write"], "settable_at": ["project", "tenant", "mailbox"], "help": "Formality register." },
        { "key": "persona.guidance", "scope": "project", "group": "persona", "type": "text", "scopes": ["config:write"], "settable_at": ["project", "tenant", "mailbox"], "help": "Extra voice/wording guidance." }
      ]
    }
  },
  "error_codes": ["INVALID_SETTINGS", "UNKNOWN_PROJECT"]
}
